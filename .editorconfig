# Neovim reads this natively, which is why config/nvim/lua/config/options.lua
# sets no indentation options of its own.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces is a hard line break in markdown; stripping them silently
# rewrites the document.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
