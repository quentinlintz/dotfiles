# Added by OrbStack: 'orb' SSH host for Linux machines.
# Only works at the top of the file, before any Host block. A missing include is
# not an error, so this is harmless if OrbStack is not installed.
Include ~/.orbstack/ssh/config

# Keeps the key in the agent and the passphrase in the macOS keychain, which is
# what makes the ssh:// rewrite in config/git/config painless.
Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
